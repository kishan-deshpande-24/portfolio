# Portfolio Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Formspree Configuration (for contact form - recommended)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# EmailJS Configuration (optional backup)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Resume PDF path (relative to public folder)
VITE_RESUME_URL=/resume.pdf

# Social Links
VITE_LINKEDIN_URL=https://linkedin.com/in/yourprofile
VITE_INSTAGRAM_URL=https://instagram.com/yourprofile
VITE_GITHUB_URL=https://github.com/yourprofile
VITE_LEETCODE_URL=https://leetcode.com/yourprofile

# Contact Email
VITE_CONTACT_EMAIL=your.email@example.com
